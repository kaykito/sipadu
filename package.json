{
	"name": "express-mssql-boilerplate",
	"version": "1.0.0",
	"private": true,
	"description": "Boilerplate Express + MSSQL server-rendered: login, single-session, RBAC menu (FITUR/OTORISASI), dynamic module dispatch, generator modul CRUD.",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"start": "node app.js",
		"dev": "nodemon app.js",
		"build": "node scripts/build-check.js",
		"generate:tables:db": "node scripts/generate-table-migrations-from-db.js",
		"db:migrate": "node scripts/migrate.js",
		"db:migrate:baseline": "node scripts/migrate.js --baseline",
		"db:seed": "node scripts/migrate.js --seed",
		"db:seed:baseline": "node scripts/migrate.js --seed --baseline",
		"db:setup": "npm run db:migrate && npm run db:seed"
	},
	"dependencies": {
		"async": "^2.6.1",
		"bcrypt": "^6.0.0",
		"body-parser": "^1.20.3",
		"connect-session-sequelize": "^8.0.1",
		"cookie-parser": "~1.4.3",
		"cors": "^2.8.5",
		"dotenv": "^16.4.5",
		"ejs": "~2.5.7",
		"express": "^4.18.2",
		"express-flash": "0.0.2",
		"express-session": "^1.15.6",
		"http-errors": "^1.6.3",
		"morgan": "~1.9.0",
		"mssql": "^11.0.1",
		"multer": "^2.0.1",
		"sequelize": "^6.37.7",
		"tedious": "^18.6.1"
	},
	"devDependencies": {
		"nodemon": "^2.0.22"
	}
}
