# Salin ke .env lalu isi nilainya

# Aplikasi
APP_NAME=Express MSSQL Boilerplate
PORT=2301
NODE_ENV=development

# Database MSSQL (data aplikasi)
DB_HOST=localhost
DB_PORT=1433
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASSWORD=your_database_password

# Database session store (opsional; default = sama dengan DB_* di atas, dan sebaiknya memang sama
# karena modul login/userProfile membaca tabel Sessions lewat koneksi DB_*)
# DB_SEQUELIZE_NAME=
# DB_SEQUELIZE_USER=
# DB_SEQUELIZE_PASSWORD=

# Session
SESSION_SECRET=ganti_dengan_string_acak_yang_panjang
SESSION_MAX_AGE=604800000
# true jika aplikasi diakses lewat HTTPS
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Origin yang diizinkan CORS (pisahkan dengan koma). Default: http://localhost:PORT
# CORS_ORIGINS=https://app.example.com

# Cloudflare Turnstile untuk form login. Aktif otomatis bila kedua key diisi;
# TURNSTILE_ENABLED=false memaksa nonaktif.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Generator modul (menu Generate Module) mati otomatis saat NODE_ENV=production.
# Set true hanya jika memang perlu generate di server production.
# GENERATOR_ENABLED=false

# HTTPS langsung dari Node (opsional; biasanya cukup lewat reverse proxy)
SSL_ENABLED=false
# SSL_KEY_PATH=
# SSL_CERT_PATH=
# SSL_CA_PATH=
