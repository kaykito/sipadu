                ${Array(8).fill().map(() => `
                  <div class="skeleton-table-row">
                    <div class="skeleton-table-cell" style="width: 5%;"></div>
                    <div class="skeleton-table-cell" style="width: 20%;"></div>
                    <div class="skeleton-table-cell" style="width: 15%;"></div>
                    <div class="skeleton-table-cell" style="width: 15%;"></div>
                    <div class="skeleton-table-cell" style="width: 15%;"></div>
                    <div class="skeleton-table-cell" style="width: 10%;"></div>
                    <div class="skeleton-table-cell" style="width: 10%;"></div>
                  </div>
                `).join('')}
              </div>
            </div>
          </div>
        `;
    }

    return baseSkeleton + contentSkeleton + '</div>';
  }

  /**
   * Menampilkan skeleton loading untuk halaman
   * @param {string} pageType - Tipe halaman yang akan dimuat
   */
  function showPageSkeleton(pageType = 'table') {
    // Fade out current content smoothly
    $('#content-wrapper').addClass('fade-out');

    setTimeout(() => {
      const skeletonHtml = createPageSkeleton(pageType);
      $('#content-wrapper').html(skeletonHtml).removeClass('fade-out');
    }, 150);
  }

  /**
   * Menyembunyikan skeleton loading dengan transisi smooth
   * @param {string} newContent - Konten baru yang akan diganti
   */
  function hidePageSkeleton(newContent) {
    const $wrapper = $('#content-wrapper');

    // Add fade effect before replacing content
    $wrapper.addClass('fade-out');

    setTimeout(() => {
      $wrapper.html(newContent).removeClass('fade-out');
    }, 200);
  }

  // ============================================
  // ENHANCED LOADING FUNCTIONS
  // ============================================

  /**
   * Membuat skeleton dengan efek stagger yang lebih smooth
   * @param {string} pageType - Tipe halaman
   * @returns {string} HTML skeleton dengan stagger effects
   */
  function createPageSkeleton(pageType = 'table') {
    const baseSkeleton = `
      <div class="page-skeleton ${pageType}" style="animation-delay: 0s;">
        <div class="skeleton-header" style="animation-delay: 0.1s;">
          <div class="skeleton-title" style="animation-delay: 0.1s;"></div>
          <div class="skeleton-subtitle" style="animation-delay: 0.2s;"></div>
        </div>
    `;

    let contentSkeleton = '';

    switch(pageType) {
      case 'dashboard':
        contentSkeleton = `
          <div class="skeleton-charts" style="animation-delay: 0.8s;">
            <div class="skeleton-chart" style="animation-delay: 0.9s;"></div>
            <div class="skeleton-chart" style="animation-delay: 1s;"></div>
            <div class="skeleton-chart" style="animation-delay: 1.1s;"></div>
            <div class="skeleton-chart" style="animation-delay: 1.2s;"></div>
          </div>
          <div class="skeleton-card" style="animation-delay: 0.3s;">
            <div class="skeleton-card-header">
              <div class="skeleton-card-title" style="animation-delay: 0.4s;"></div>
              <div class="skeleton-button" style="animation-delay: 0.5s;"></div>
            </div>
            <div class="skeleton-table" style="animation-delay: 1s;">
              <div class="skeleton-table-header">
                <div class="skeleton-table-header-item" style="width: 20%; animation-delay: 1.1s;"></div>
                <div class="skeleton-table-header-item" style="width: 25%; animation-delay: 1.1s;"></div>
                <div class="skeleton-table-header-item" style="width: 15%; animation-delay: 1.1s;"></div>
                <div class="skeleton-table-header-item" style="width: 15%; animation-delay: 1.1s;"></div>
                <div class="skeleton-table-header-item" style="width: 10%; animation-delay: 1.1s;"></div>
              </div>
              <div class="skeleton-table-body">
                ${Array(5).fill().map((_, i) => `
                  <div class="skeleton-table-row" style="animation-delay: ${1.2 + i * 0.1}s;">
                    <div class="skeleton-table-cell" style="width: 20%;"></div>
                    <div class="skeleton-table-cell" style="width: 25%;"></div>
                    <div class="skeleton-table-cell" style="width: 15%;"></div>
                    <div class="skeleton-table-cell" style="width: 15%;"></div>
                    <div class="skeleton-table-cell" style="width: 10%;"></div>
                  </div>
                `).join('')}
              </div>
            </div>
          </div>
        `;
        break;

      case 'form':
        contentSkeleton = `
          <div class="skeleton-card" style="animation-delay: 0.3s;">
            <div class="skeleton-card-header">
              <div class="skeleton-card-title" style="animation-delay: 0.4s;"></div>
            </div>
            <div class="row">
              ${Array(6).fill().map((_, i) => `
                <div class="col-md-6">
                  <div class="skeleton-form-group" style="animation-delay: ${0.4 + i * 0.1}s;">
                    <div class="skeleton-form-label"></div>
                    <div class="skeleton-form-input"></div>
                  </div>
                </div>
              `).join('')}
            </div>
            <div class="d-flex justify-content-end gap-2 mt-3">
              <div class="skeleton-button" style="width: 80px; animation-delay: 1.1s;"></div>
              <div class="skeleton-button" style="width: 100px; animation-delay: 1.2s;"></div>
            </div>
          </div>
        `;
        break;

      case 'detail':
        contentSkeleton = `
          <div class="skeleton-card" style="animation-delay: 0.3s;">
            <div class="skeleton-card-header">
              <div class="skeleton-card-title" style="animation-delay: 0.4s;"></div>
              <div class="skeleton-button" style="animation-delay: 0.5s;"></div>
            </div>
            <div class="row">
              ${Array(4).fill().map((_, i) => `
                <div class="col-md-6">
                  <div class="skeleton-form-group" style="animation-delay: ${0.5 + i * 0.1}s;">
                    <div class="skeleton-form-label"></div>
                    <div class="skeleton-form-input"></div>
                  </div>
                </div>
              `).join('')}
            </div>
          </div>
          <div class="skeleton-card" style="animation-delay: 0.9s;">
            <div class="skeleton-card-header">
              <div class="skeleton-card-title" style="animation-delay: 1s;"></div>
              <div class="skeleton-button" style="animation-delay: 1.1s;"></div>
            </div>
            <div class="skeleton-table" style="animation-delay: 1.2s;">
              <div class="skeleton-table-header">
                <div class="skeleton-table-header-item" style="width: 15%; animation-delay: 1.3s;"></div>
                <div class="skeleton-table-header-item" style="width: 30%; animation-delay: 1.3s;"></div>
                <div class="skeleton-table-header-item" style="width: 20%; animation-delay: 1.3s;"></div>
                <div class="skeleton-table-header-item" style="width: 15%; animation-delay: 1.3s;"></div>
                <div class="skeleton-table-header-item" style="width: 10%; animation-delay: 1.3s;"></div>
              </div>
              <div class="skeleton-table-body">
                ${Array(3).fill().map((_, i) => `
                  <div class="skeleton-table-row" style="animation-delay: ${1.4 + i * 0.1}s;">
                    <div class="skeleton-table-cell" style="width: 15%;"></div>
                    <div class="skeleton-table-cell" style="width: 30%;"></div>
                    <div class="skeleton-table-cell" style="width: 20%;"></div>
                    <div class="skeleton-table-cell" style="width: 15%;"></div>
                    <div class="skeleton-table-cell" style="width: 10%;"></div>
                  </div>
                `).join('')}
              </div>
            </div>
          </div>
        `;
        break;

      default: // 'table' - default case
        contentSkeleton = `
          <div class="skeleton-card" style="animation-delay: 0.3s;">
            <div class="skeleton-card-header">
              <div class="skeleton-card-title" style="animation-delay: 0.4s;"></div>
              <div class="skeleton-button" style="animation-delay: 0.5s;"></div>
            </div>
            <div class="skeleton-filters" style="animation-delay: 0.6s;">
              <div class="skeleton-filter" style="animation-delay: 0.7s;"></div>
              <div class="skeleton-filter" style="animation-delay: 0.8s;"></div>
              <div class="skeleton-filter" style="animation-delay: 0.9s;"></div>
            </div>
            <div class="skeleton-table" style="animation-delay: 1s;">
              <div class="skeleton-table-header">
                <div class="skeleton-table-header-item" style="width: 5%; animation-delay: 1.1s;"></div>
                <div class="skeleton-table-header-item" style="width: 20%; animation-delay: 1.1s;"></div>
                <div class="skeleton-table-header-item" style="width: 15%; animation-delay: 1.1s;"></div>
                <div class="skeleton-table-header-item" style="width: 15%; animation-delay: 1.1s;"></div>
                <div class="skeleton-table-header-item" style="width: 15%; animation-delay: 1.1s;"></div>
                <div class="skeleton-table-header-item" style="width: 10%; animation-delay: 1.1s;"></div>
                <div class="skeleton-table-header-item" style="width: 10%; animation-delay: 1.1s;"></div>
              </div>
              <div class="skeleton-table-body">
                ${Array(8).fill().map((_, i) => `
                  <div class="skeleton-table-row" style="animation-delay: ${1.2 + i * 0.08}s;">
                    <div class="skeleton-table-cell" style="width: 5%;"></div>
                    <div class="skeleton-table-cell" style="width: 20%;"></div>
                    <div class="skeleton-table-cell" style="width: 15%;"></div>
                    <div class="skeleton-table-cell" style="width: 15%;"></div>
                    <div class="skeleton-table-cell" style="width: 15%;"></div>
                    <div class="skeleton-table-cell" style="width: 10%;"></div>
                    <div class="skeleton-table-cell" style="width: 10%;"></div>
                  </div>
                `).join('')}
              </div>
            </div>
          </div>
        `;
    }

    return baseSkeleton + contentSkeleton + '</div>';
  }
</script>

<script src="/assets/js/spa-core.js"></script>

<script>
  (function setupAutoLogoutIdle() {
    var IDLE_TIMEOUT_MS = 10 * 60 * 1000; // 10 menit
    var WARNING_BEFORE_MS = 30 * 1000; // tampilkan warning 30 detik sebelum logout
    var WARNING_START_SECONDS = 30;
    var idleTimer = null;
    var warningTimer = null;
    var countdownInterval = null;
    var hasLoggedOut = false;
    var warningSecondsLeft = WARNING_START_SECONDS;

    function ensureWarningModal() {
      if (document.getElementById('idleWarningModal')) return;

      var modalHtml = [
        '<div id="idleWarningModal" style="display:none;position:fixed;inset:0;z-index:2000;background:rgba(0,0,0,0.5);align-items:center;justify-content:center;padding:16px;">',
          '<div style="width:100%;max-width:420px;background:#fff;border-radius:12px;padding:20px;box-shadow:0 10px 30px rgba(0,0,0,0.2);">',
            '<h5 style="margin:0 0 10px 0;">Peringatan Sesi</h5>',
            '<p style="margin:0 0 16px 0;">Anda akan logout otomatis dalam <strong id="idleWarningCountdown">30</strong> detik karena tidak ada aktivitas.</p>',
            '<div style="display:flex;justify-content:flex-end;gap:10px;">',
              '<button id="stayLoggedInBtn" type="button" class="btn btn-primary">Tetap Login</button>',
            '</div>',
          '</div>',
        '</div>'
      ].join('');

      document.body.insertAdjacentHTML('beforeend', modalHtml);

      var stayBtn = document.getElementById('stayLoggedInBtn');
      if (stayBtn) {
        stayBtn.addEventListener('click', function () {
          hideWarning();
          resetIdleTimer();
        });
      }
    }

    function showWarning() {
      if (hasLoggedOut) return;
      ensureWarningModal();
      warningSecondsLeft = WARNING_START_SECONDS;

      var modal = document.getElementById('idleWarningModal');
      var countdownEl = document.getElementById('idleWarningCountdown');
      if (!modal || !countdownEl) return;

      modal.style.display = 'flex';
      countdownEl.textContent = String(warningSecondsLeft);

      if (countdownInterval) clearInterval(countdownInterval);
      countdownInterval = setInterval(function () {
        warningSecondsLeft -= 1;
        if (warningSecondsLeft <= 0) {
          clearInterval(countdownInterval);
          countdownInterval = null;
          warningSecondsLeft = 0;
          countdownEl.textContent = '0';
          return;
        }
        countdownEl.textContent = String(warningSecondsLeft);
      }, 1000);
    }

    function hideWarning() {
      var modal = document.getElementById('idleWarningModal');
      if (modal) modal.style.display = 'none';
      if (countdownInterval) {
        clearInterval(countdownInterval);
        countdownInterval = null;
      }
      warningSecondsLeft = WARNING_START_SECONDS;
    }

    function triggerAutoLogout() {
      if (hasLoggedOut) return;
      hasLoggedOut = true;
      hideWarning();
      window.location.href = '/login/logout';
    }

    function resetIdleTimer() {
      if (hasLoggedOut) return;
      hideWarning();
      if (idleTimer) {
        clearTimeout(idleTimer);
      }
      if (warningTimer) {
        clearTimeout(warningTimer);
      }
      warningTimer = setTimeout(showWarning, IDLE_TIMEOUT_MS - WARNING_BEFORE_MS);
      idleTimer = setTimeout(triggerAutoLogout, IDLE_TIMEOUT_MS);
    }

    ['mousemove', 'mousedown', 'keydown', 'scroll', 'touchstart', 'click'].forEach(function (eventName) {
      window.addEventListener(eventName, resetIdleTimer, { passive: true });
    });

    window.addEventListener('load', resetIdleTimer);
    document.addEventListener('visibilitychange', function () {
      if (!document.hidden) resetIdleTimer();
    });
  })();
</script>


