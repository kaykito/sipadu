<script>
  // ============================================
  // PAGE SKELETON LOADING FUNCTIONS
  // ============================================

  /**
   * Membuat skeleton loading untuk halaman berdasarkan tipe
   * @param {string} pageType - Tipe halaman ('dashboard', 'table', 'form', 'detail')
   * @returns {string} HTML skeleton
   */
  function createPageSkeleton(pageType = 'table') {
    const baseSkeleton = `
      <div class="page-skeleton ${pageType}">
        <div class="skeleton-header">
          <div class="skeleton-title"></div>
          <div class="skeleton-subtitle"></div>
        </div>
    `;

    let contentSkeleton = '';

    switch(pageType) {
      case 'dashboard':
        contentSkeleton = `
          <div class="skeleton-charts">
            <div class="skeleton-chart"></div>
            <div class="skeleton-chart"></div>
            <div class="skeleton-chart"></div>
            <div class="skeleton-chart"></div>
          </div>
          <div class="skeleton-card">
            <div class="skeleton-card-header">
              <div class="skeleton-card-title"></div>
              <div class="skeleton-button"></div>
            </div>
            <div class="skeleton-table">
              <div class="skeleton-table-header">
                <div class="skeleton-table-header-item" style="width: 20%;"></div>
                <div class="skeleton-table-header-item" style="width: 25%;"></div>
                <div class="skeleton-table-header-item" style="width: 15%;"></div>
                <div class="skeleton-table-header-item" style="width: 15%;"></div>
                <div class="skeleton-table-header-item" style="width: 10%;"></div>
              </div>
              <div class="skeleton-table-body">
                ${Array(5).fill().map(() => `
                  <div class="skeleton-table-row">
                    <div class="skeleton-table-cell" style="width: 20%;"></div>
                    <div class="skeleton-table-cell" style="width: 25%;"></div>
                    <div class="skeleton-table-cell" style="width: 15%;"></div>
                    <div class="skeleton-table-cell" style="width: 15%;"></div>
                    <div class="skeleton-table-cell" style="width: 10%;"></div>
                  </div>
                `).join('')}
              </div>
            </div>
          </div>
        `;
        break;

      case 'form':
        contentSkeleton = `
          <div class="skeleton-card">
            <div class="skeleton-card-header">
              <div class="skeleton-card-title"></div>
            </div>
            <div class="row">
              ${Array(6).fill().map(() => `
                <div class="col-md-6">
                  <div class="skeleton-form-group">
                    <div class="skeleton-form-label"></div>
                    <div class="skeleton-form-input"></div>
                  </div>
                </div>
              `).join('')}
            </div>
            <div class="d-flex justify-content-end gap-2 mt-3">
              <div class="skeleton-button" style="width: 80px;"></div>
              <div class="skeleton-button" style="width: 100px;"></div>
            </div>
          </div>
        `;
        break;

      case 'detail':
        contentSkeleton = `
          <div class="skeleton-card">
            <div class="skeleton-card-header">
              <div class="skeleton-card-title"></div>
              <div class="skeleton-button"></div>
            </div>
            <div class="row">
              ${Array(4).fill().map(() => `
                <div class="col-md-6">
                  <div class="skeleton-form-group">
                    <div class="skeleton-form-label"></div>
                    <div class="skeleton-form-input"></div>
                  </div>
                </div>
              `).join('')}
            </div>
          </div>
          <div class="skeleton-card">
            <div class="skeleton-card-header">
              <div class="skeleton-card-title"></div>
              <div class="skeleton-button"></div>
            </div>
            <div class="skeleton-table">
              <div class="skeleton-table-header">
                <div class="skeleton-table-header-item" style="width: 15%;"></div>
                <div class="skeleton-table-header-item" style="width: 30%;"></div>
                <div class="skeleton-table-header-item" style="width: 20%;"></div>
                <div class="skeleton-table-header-item" style="width: 15%;"></div>
                <div class="skeleton-table-header-item" style="width: 10%;"></div>
              </div>
              <div class="skeleton-table-body">
                ${Array(3).fill().map(() => `
                  <div class="skeleton-table-row">
                    <div class="skeleton-table-cell" style="width: 15%;"></div>
                    <div class="skeleton-table-cell" style="width: 30%;"></div>
                    <div class="skeleton-table-cell" style="width: 20%;"></div>
                    <div class="skeleton-table-cell" style="width: 15%;"></div>
                    <div class="skeleton-table-cell" style="width: 10%;"></div>
                  </div>
                `).join('')}
              </div>
            </div>
          </div>
        `;
        break;

      default: // 'table' - default case
        contentSkeleton = `
          <div class="skeleton-card">
            <div class="skeleton-card-header">
              <div class="skeleton-card-title"></div>
              <div class="skeleton-button"></div>
            </div>
            <div class="skeleton-filters">
              <div class="skeleton-filter"></div>
              <div class="skeleton-filter"></div>
              <div class="skeleton-filter"></div>
            </div>
            <div class="skeleton-table">
