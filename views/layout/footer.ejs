  /**
   * Format tanggal ke format Indonesia
   * @param {Date|string} tgl - Tanggal yang akan diformat
   * @returns {string} Tanggal dalam format Indonesia atau '-' jika null
   */
  function formatTanggalIndo(tgl) {
    if (!tgl) return '-';
    const dateObj = typeof tgl === 'string' ? new Date(tgl) : tgl;
    return dateObj.toLocaleDateString('id-ID', {
      day: 'numeric',
      month: 'long',
      year: 'numeric'
    });
  }

</script>


