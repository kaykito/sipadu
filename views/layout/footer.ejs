                <div class="skeleton-table-header-item" style="width: 5%;"></div>
                <div class="skeleton-table-header-item" style="width: 20%;"></div>
                <div class="skeleton-table-header-item" style="width: 15%;"></div>
                <div class="skeleton-table-header-item" style="width: 15%;"></div>
                <div class="skeleton-table-header-item" style="width: 15%;"></div>
                <div class="skeleton-table-header-item" style="width: 10%;"></div>
                <div class="skeleton-table-header-item" style="width: 10%;"></div>
